<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <CinemaWriterProxy name="CinemaWriter" class="CinemaWriter" label="Cinema Writer">

      <Documentation
        long_help="Writes 2D Cinema image samples and a data.csv manifest. Pipeline provenance is captured from the client-side ServerManager graph immediately before execution, then synchronized to the writer so the same implementation works in built-in and client/server sessions."
        short_help="Write 2D Cinema image samples with pipeline provenance." />

      <InputProperty
        name="Input"
        command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="sources" />
          <Group name="filters" />
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataObject" />
        </DataTypeDomain>
      </InputProperty>

      <StringVectorProperty name="OutputDirectory" command="SetOutputDirectory" number_of_elements="1">
        <Documentation>Output Directory (must already exist!).</Documentation>
        <FileListDomain name="files" />
        <Hints>
          <UseDirectoryName />
        </Hints>
      </StringVectorProperty>

      <IntVectorProperty name="Format" command="SetFormat" number_of_elements="1" default_values="0">
        <EnumerationDomain name="enum">
          <Entry value="0" text="PyCinema HDF5"/>
          <Entry value="1" text="PNG Image"/>
        </EnumerationDomain>
        <Documentation>Store images as PyCinema HDF5 files or PNG images.</Documentation>
      </IntVectorProperty>

      <IntVectorProperty name="CompressionLevel" command="SetCompressionLevel" number_of_elements="1" default_values="5">
        <IntRangeDomain name="range" min="0" max="9" />
        <Documentation>Determines the compression level from 0 (fast + large files) to 9 (slow + small files).</Documentation>
      </IntVectorProperty>

      <!--
        Client/server provenance transport. vtkSMCinemaWriterProxy fills this
        alternating key/value vector immediately before UpdatePipeline().
        ServerManager first invokes ClearProvenance(), then invokes
        AddProvenanceEntry(key, value) for every pair on the server-side
        CinemaWriter instance.
      -->
      <StringVectorProperty
        name="Provenance"
        command="AddProvenanceEntry"
        clean_command="ClearProvenance"
        number_of_elements_per_command="2"
        repeat_command="1"
        panel_visibility="never"
        is_internal="1" />

      <Property name="Debug_Execute"
        label="Write Images"
        command="Modified"
        panel_widget="command_button">
        <Documentation>
          Write all input images to disk using the selected output format.
        </Documentation>
      </Property>

      <Property name="DeleteDatabase" command="DeleteDatabase" panel_widget="command_button">
        <Documentation>Delete the contents of the output directory [WARNING: NO UNDO!]</Documentation>
      </Property>
      <Property label="Create data.csv" name="CreateDataCSV" command="CreateDataCSV" panel_widget="command_button">
        <Documentation>Compute the data.csv file.</Documentation>
      </Property>

      <Hints>
        <ShowInMenu category="Cinema Export" />
        <RepresentationType view="RenderView" type="Outline"/>
        <Visibility replace_input="0" />
      </Hints>

    </CinemaWriterProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
